{
	"id": "edit-sheets-and-columns",
	"cases": [
		{
			"note": "another sheet's formulas are rewritten only for references that target the edited sheet",
			"operation": "delete-columns",
			"input": {
				"workbook": {
					"sheets": [
						{
							"id": "sheet-1",
							"name": "Sales",
							"columns": [
								{
									"id": "A",
									"name": "X"
								},
								{
									"id": "B",
									"name": "Y"
								}
							],
							"records": [
								[
									"1",
									"2"
								]
							],
							"cells": {}
						},
						{
							"id": "sheet-2",
							"name": "Other Sheet",
							"columns": [
								{
									"id": "A",
									"name": "Z"
								}
							],
							"records": [
								[
									"3"
								]
							],
							"cells": {
								"A2": {
									"formula": "=Sales!A2+'Other Sheet'!B2+B2"
								}
							}
						}
					]
				},
				"args": {
					"sheet": "Sales",
					"columns": [
						"A"
					]
				}
			},
			"expected": {
				"formulas": {
					"sheet-2": {
						"A2": "=#REF!+'Other Sheet'!B2+B2"
					}
				}
			}
		},
		{
			"note": "an inserted column has the empty name; ids follow position",
			"operation": "insert-columns",
			"input": {
				"workbook": {
					"sheets": [
						{
							"id": "sheet-1",
							"name": "Sales",
							"columns": [
								{
									"id": "A",
									"name": "X"
								},
								{
									"id": "B",
									"name": "Y"
								}
							],
							"records": [
								[
									"1",
									"2"
								]
							],
							"cells": {}
						},
						{
							"id": "sheet-2",
							"name": "Other Sheet",
							"columns": [
								{
									"id": "A",
									"name": "Z"
								}
							],
							"records": [
								[
									"3"
								]
							],
							"cells": {
								"A2": {
									"formula": "=Sales!A2+'Other Sheet'!B2+B2"
								}
							}
						}
					]
				},
				"args": {
					"sheet": "Sales",
					"at": "A",
					"count": 1
				}
			},
			"expected": {
				"columns": {
					"sheet-1": [
						{
							"id": "A",
							"name": ""
						},
						{
							"id": "B",
							"name": "X"
						},
						{
							"id": "C",
							"name": "Y"
						}
					]
				},
				"formulas": {
					"sheet-2": {
						"A2": "=Sales!B2+'Other Sheet'!B2+B2"
					}
				}
			}
		},
