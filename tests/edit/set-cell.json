		{
			"note": "a supported edit makes the embedded source's authority csvx (14.2)",
			"operation": "set-cell",
			"input": {
				"workbook": {
					"sheets": [
						{
							"id": "sheet-1",
							"name": "Sheet1",
							"columns": [
								{
									"id": "A",
									"name": "Qty",
									"type": "integer"
								},
								{
									"id": "B",
									"name": "Note"
								}
							],
							"records": [
