								[
									"2",
									"y"
								]
							],
							"cells": {
								"B2": {
									"formula": "=A2",
									"cached": {
										"type": "integer",
										"value": "2"
									}
								}
							}
						}
					]
				},
				"args": {
					"sheet": "Sheet1",
					"coordinate": "B2",
					"text": "plain"
