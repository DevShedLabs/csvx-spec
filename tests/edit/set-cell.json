					"source": {
						"format": "xlsx",
						"filename": "a.xlsx",
						"sha256": "00",
						"authority": "original",
						"importedAt": "2026-01-01T00:00:00Z",
						"importer": "x"
					}
				},
				"args": {
					"sheet": "Sheet1",
					"coordinate": "B2",
					"text": "edited"
				}
			},
			"expected": {
				"sourceAuthority": "csvx"
			}
