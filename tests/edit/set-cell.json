{
	"id": "edit-set-cell",
	"cases": [
		{
			"note": "literal replaces content: formula, type and cached dropped; style and validation kept",
			"operation": "set-cell",
			"input": {
				"workbook": {
					"sheets": [
						{
							"id": "sheet-1",
							"name": "Sheet1",
							"columns": [
								{
									"id": "A",
									"name": "Qty",
									"type": "integer"
								},
								{
									"id": "B",
									"name": "Note"
								}
							],
							"records": [
								[
									"1",
									"x"
								],
								[
									"2",
									"y"
								]
							],
							"cells": {
								"B2": {
									"formula": "=A2",
									"type": "string",
									"cached": {
										"type": "integer",
										"value": "2"
									},
									"style": "cur",
									"validation": "v1"
								}
							}
						}
					],
					"styles": [
						{
							"id": "cur",
							"numberFormat": "\"$\"#,##0.00"
						}
					]
				},
				"args": {
					"sheet": "Sheet1",
					"coordinate": "B2",
					"text": "hello"
				}
			},
			"expected": {
				"records": [
					[
						"1",
						"hello"
					],
					[
						"2",
						"y"
					]
				],
				"cells": {
					"B2": {
						"style": "cur",
						"validation": "v1"
					}
				}
			}
		},
		{
			"note": "a literal that leaves no metadata removes the entry",
			"operation": "set-cell",
			"input": {
				"workbook": {
					"sheets": [
						{
							"id": "sheet-1",
							"name": "Sheet1",
