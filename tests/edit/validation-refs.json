							"cells": {
								"A2": {
									"validation": {
										"type": "list",
										"formula1": "=$C$2:$C$6",
										"message": "pick one"
									}
								}
							}
						}
					]
				},
				"args": {
					"sheet": "Sales",
					"at": 4,
					"count": 1
