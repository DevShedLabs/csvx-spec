{
	"id": "edit-validation-refs",
	"cases": [
		{
			"note": "validation formulas starting with = are rewritten; unqualified references target the cell's own sheet",
			"operation": "insert-rows",
			"input": {
				"workbook": {
					"sheets": [
						{
							"id": "sheet-1",
							"name": "Sales",
