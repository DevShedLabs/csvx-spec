				}
			},
			"expected": {
				"csv": ",,,,\nName,Amount,Date,Active,Zip\nAda,19.95,2026-09-22,true,02134\n\"Lovelace, Countess\",3,2026-09-23,false,10001\n=SUM(A1),,2026-09-24,true,\n"
			}
		},
