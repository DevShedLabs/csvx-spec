{
	"id": "csvx-to-xlsx",
	"operation": "csvx-to-xlsx",
	"cases": [
		{
			"note": "scalar types survive: string, decimal, boolean, and the date as its ISO text",
			"input": "../../examples/typed-data.csvx",
			"expected": {
				"schemaValid": true,
				"samples": [
					{
						"sheet": "Data",
						"cell": "A1",
						"type": "string",
						"value": "Name"
					},
					{
						"sheet": "Data",
						"cell": "A2",
						"type": "string",
						"value": "Ada"
					},
					{
						"sheet": "Data",
						"cell": "B2",
						"type": "decimal",
						"value": "19.95"
					},
					{
						"sheet": "Data",
						"cell": "C2",
						"type": "date",
						"value": "2026-09-22"
					},
					{
						"sheet": "Data",
						"cell": "D2",
						"type": "boolean",
						"value": "true"
					}
				]
			}
		},
		{
			"note": "styles survive: number format, alignment, bold, fill (and the text 'Total' in a decimal column is kept as text, with a warning)",
			"input": "../../examples/styled.csvx",
			"expected": {
				"schemaValid": true,
				"samples": [
					{
						"sheet": "Report",
						"cell": "A2",
						"style.numberFormat": "$#,##0.00"
					},
					{
						"sheet": "Report",
						"cell": "A2",
						"style.alignment.horizontal": "right"
					},
					{
						"sheet": "Report",
						"cell": "A3",
						"style.font.bold": true
					},
					{
						"sheet": "Report",
						"cell": "A3",
						"style.fill.color": "#E8F0FE"
					}
				],
				"warnings": [
					{
						"feature": "value",
						"name": "Report!A3"
					}
				]
			}
		},
		{
			"note": "formulas keep their text and typed cached values",
			"input": "../../examples/formulas.csvx",
			"expected": {
				"schemaValid": true,
				"samples": [
					{
						"sheet": "Calculation",
						"cell": "C2",
						"formula": "=A2*B2",
						"cached.type": "decimal",
						"cached.value": "9.00"
					},
					{
						"sheet": "Calculation",
						"cell": "C4",
						"formula": "=SUM(C2:C3)",
						"cached.value": "15.00"
					}
				]
			}
		},
		{
			"note": "cross-sheet formulas and several sheets; the needless quotes around Sales in the source formula are gone after the XLSX round trip (14.11)",
			"input": "../../examples/multi-sheet.csvx",
			"expected": {
				"schemaValid": true,
				"samples": [
					{
						"sheet": "Sales",
						"cell": "A2",
						"type": "decimal",
						"value": "10.00"
					},
					{
						"sheet": "Summary",
						"cell": "A2",
						"formula": "=SUM(Sales!A2:A3)",
						"cached.value": "22.50"
					}
				]
			}
		},
		{
			"note": "print settings, including the print names, survive",
			"input": "../../examples/print.csvx",
			"expected": {
				"schemaValid": true,
				"samples": [
					{
						"sheet": "Report",
						"print.orientation": "landscape"
					},
					{
						"sheet": "Report",
						"print.paperSize": "a4"
					},
					{
						"sheet": "Report",
						"print.pageOrder": "overThenDown"
					},
					{
						"sheet": "Report",
						"print.fitToWidth": 1
					},
					{
						"sheet": "Report",
						"print.fitToHeight": 0
					},
					{
						"sheet": "Report",
						"print.area": "A1:E3"
					},
					{
						"sheet": "Report",
						"print.repeatRows": "1:1"
					},
					{
						"sheet": "Report",
						"print.repeatColumns": "A:A"
					},
					{
						"sheet": "Report",
						"print.gridlines": true
					},
					{
						"sheet": "Report",
						"print.centerHorizontally": true
					},
					{
						"sheet": "Report",
						"print.margins.top": 0.5
					},
					{
						"sheet": "Report",
						"print.margins.left": 0.3
					},
					{
						"sheet": "Report",
						"print.columnBreaks": [
							3
						]
					},
					{
						"sheet": "Report",
						"print.rowBreaks": [
							2
						]
					}
				],
				"warnings": [
					{
						"feature": "print",
						"name": "headerFooter"
					}
				]
			}
		},
		{
			"note": "names, edits, and an XLSX-illegal sheet name: the edit is exported, names survive, the sheet is renamed and its formulas rewritten",
			"input": "../../examples/multi-sheet.csvx",
			"edits": [
				{
					"operation": "rename-sheet",
					"args": {
						"sheet": "Sales",
						"name": "Q1/Q2 Sales"
					}
				},
				{
					"operation": "set-cell",
					"args": {
						"sheet": "Summary",
						"coordinate": "A3",
						"text": "7.50"
					}
				}
			],
			"namedRanges": [
				{
					"name": "Block",
					"refersTo": "=Sales!$A$2:$A$3"
				}
			],
			"expected": {
				"schemaValid": true,
				"namedRanges": [
					{
						"name": "Block",
						"refersTo": "='Q1_Q2 Sales'!$A$2:$A$3"
					}
				],
				"samples": [
					{
						"sheet": "Summary",
						"cell": "A3",
						"type": "decimal",
						"value": "7.50"
					},
					{
						"sheet": "Summary",
						"cell": "A2",
						"formula": "=SUM('Q1_Q2 Sales'!A2:A3)"
					}
				],
				"sheetNames": [
					"Q1_Q2 Sales",
					"Summary"
				],
				"warnings": [
					{
						"feature": "sheetName",
						"name": "Q1/Q2 Sales"
					}
				]
			}
		}
	]
}
