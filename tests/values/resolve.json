{
	"id": "resolve-cell-value",
	"operation": "resolve-cell-value",
	"cases": [
		{
			"note": "text that does not match a declared decimal is an error, never silently a string",
			"input": {
				"raw": "Total",
				"declaredType": "decimal"
			},
			"expected": {
				"type": "error",
				"code": "VALUE"
			}
		},
		{
			"note": "text that does not match a declared integer is an error",
			"input": {
				"raw": "abc",
				"declaredType": "integer"
			},
			"expected": {
				"type": "error",
				"code": "VALUE"
			}
		},
		{
			"note": "a declared integer accepts 3.0 as the integer 3",
			"input": {
				"raw": "3.0",
				"declaredType": "integer"
			},
			"expected": {
				"type": "integer",
				"value": 3
			}
		},
		{
			"note": "a declared decimal keeps its text exactly",
			"input": {
				"raw": "19.50",
				"declaredType": "decimal"
			},
			"expected": {
				"type": "decimal",
				"value": "19.50"
			}
		},
		{
			"note": "a declared string keeps leading zeros",
			"input": {
				"raw": "007",
				"declaredType": "string"
			},
			"expected": {
				"type": "string",
				"value": "007"
			}
		},
		{
			"note": "untyped 007 is a string, not a number",
			"input": {
				"raw": "007"
			},
			"expected": {
				"type": "string",
				"value": "007"
			}
		},
		{
			"note": "untyped 19.50 is a decimal with its text kept",
			"input": {
				"raw": "19.50"
			},
			"expected": {
				"type": "decimal",
				"value": "19.50"
			}
		},
		{
			"note": "untyped true is a boolean",
			"input": {
				"raw": "true"
			},
			"expected": {
				"type": "boolean",
				"value": true
			}
		},
		{
			"note": "untyped True is a string (literals are case-sensitive)",
			"input": {
				"raw": "True"
			},
			"expected": {
				"type": "string",
				"value": "True"
			}
		},
		{
			"note": "empty is blank",
			"input": {
				"raw": ""
			},
			"expected": {
				"type": "blank"
			}
		},
		{
			"note": "a declared date keeps its text",
			"input": {
				"raw": "2026-09-22",
				"declaredType": "date"
			},
			"expected": {
				"type": "date",
				"value": "2026-09-22"
			}
		},
		{
			"note": "a number format does not alter the value: currency text resolves to the same decimal",
			"input": {
				"raw": "$7.00",
				"numberFormat": "\"$\"#,##0.00"
			},
			"expected": {
				"type": "decimal",
				"value": "7.00"
			}
		},
		{
			"note": "text that does not match the format's shape falls through to the untyped rules",
			"input": {
				"raw": "n/a",
				"numberFormat": "\"$\"#,##0.00"
			},
			"expected": {
				"type": "string",
				"value": "n/a"
			}
		},
		{
			"note": "a declared type wins over a number format",
			"input": {
				"raw": "$7.00",
				"declaredType": "string",
				"numberFormat": "\"$\"#,##0.00"
			},
			"expected": {
				"type": "string",
				"value": "$7.00"
			}
		}
	]
}
