{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csvx.dev/schemas/styles.schema.json",
  "title": "CSVX Styles",
  "type": "object",
  "additionalProperties": true,
  "required": ["styles"],
  "$defs": {
    "borderLineStyle": { "enum": ["none", "thin", "medium", "thick", "dashed", "dotted", "double"] },
    "borderEdge": {
      "type": "object",
      "properties": {
        "style": { "$ref": "#/$defs/borderLineStyle" },
        "color": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "properties": {
    "styles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
          "numberFormat": { "type": "string" },
          "font": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "size": { "type": "number", "exclusiveMinimum": 0, "description": "Font size in points (spec/08-styles.md); default 11." },
              "bold": { "type": "boolean" },
              "italic": { "type": "boolean" },
              "underline": { "type": "boolean" },
              "color": { "type": "string" }
            },
            "additionalProperties": true
          },
          "fill": { "type": "object", "additionalProperties": true },
          "border": {
            "type": "object",
            "properties": {
              "style": { "$ref": "#/$defs/borderLineStyle" },
              "color": { "type": "string" },
              "top": { "$ref": "#/$defs/borderEdge" },
              "right": { "$ref": "#/$defs/borderEdge" },
              "bottom": { "$ref": "#/$defs/borderEdge" },
              "left": { "$ref": "#/$defs/borderEdge" }
            },
            "additionalProperties": true
          },
          "alignment": { "type": "object", "additionalProperties": true },
          "protection": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": true
      }
    }
  }
}
