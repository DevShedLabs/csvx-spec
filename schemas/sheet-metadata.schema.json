{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csvx.dev/schemas/sheet-metadata.schema.json",
  "title": "CSVX Sheet Metadata",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "columns": {
      "type": "array",
      "items": { "$ref": "#/$defs/column" }
    },
    "rowHeights": {
      "type": "object",
      "description": "Row height by 1-based row number, in points (XLSX's own unit; its default row height is 15pt) — see spec/03-sheets.md.",
      "propertyNames": { "pattern": "^[0-9]+$" },
      "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
    },
    "print": { "$ref": "#/$defs/print" },
    "cells": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z]+[1-9][0-9]*$" },
      "additionalProperties": { "$ref": "#/$defs/cell" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
    "scalarType": {
      "enum": ["blank", "boolean", "integer", "decimal", "string", "date", "time", "datetime", "error"]
    },
    "print": {
      "type": "object",
      "additionalProperties": true,
      "description": "Print and pagination settings — see spec/03-sheets.md (Print settings) and spec/14-xlsx-interoperability.md.",
      "properties": {
        "orientation": { "enum": ["portrait", "landscape"] },
        "paperSize": { "enum": ["letter", "legal", "tabloid", "a3", "a4", "a5"] },
        "margins": {
          "type": "object",
          "additionalProperties": true,
          "description": "Inches, the unit XLSX uses.",
          "properties": {
            "top": { "type": "number", "minimum": 0 },
            "right": { "type": "number", "minimum": 0 },
            "bottom": { "type": "number", "minimum": 0 },
            "left": { "type": "number", "minimum": 0 }
          }
        },
        "scale": { "type": "number", "minimum": 10, "maximum": 400 },
        "fitToWidth": { "type": "integer", "minimum": 0 },
        "fitToHeight": { "type": "integer", "minimum": 0 },
        "area": { "type": "string", "pattern": "^[A-Z]+[1-9][0-9]*:[A-Z]+[1-9][0-9]*$" },
        "repeatRows": { "type": "string", "pattern": "^[1-9][0-9]*:[1-9][0-9]*$" },
        "repeatColumns": { "type": "string", "pattern": "^[A-Z]+:[A-Z]+$" },
        "pageOrder": { "enum": ["downThenOver", "overThenDown"] },
        "gridlines": { "type": "boolean" },
        "centerHorizontally": { "type": "boolean" },
        "columnBreaks": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "rowBreaks": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
      }
    },
    "column": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "type": { "$ref": "#/$defs/scalarType" },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "XLSX character-width units (the number of '0' glyphs, in the workbook's default font, that fit the column, plus padding) — see spec/03-sheets.md for the canonical pixel conversion formula every engine must use."
        }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": { "$ref": "#/$defs/scalarType" },
        "formula": { "type": "string", "pattern": "^=" },
        "cached": { "$ref": "formulas.schema.json#/$defs/value" },
        "style": { "$ref": "#/$defs/id" },
        "validation": { "$ref": "#/$defs/validation" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": { "enum": ["whole", "decimal", "list", "date", "textLength", "custom"] },
        "allowBlank": { "type": "boolean" },
        "operator": { "type": "string" },
        "formula1": { "type": "string" },
        "formula2": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
