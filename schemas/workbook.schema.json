{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csvx.dev/schemas/workbook.schema.json",
  "title": "CSVX Workbook",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "version", "sheets"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "version": { "const": "1.0" },
    "sheets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "path"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1, "maxLength": 255 },
          "path": { "type": "string", "pattern": "^sheets/[A-Za-z][A-Za-z0-9_-]{0,63}\\.csv$" },
          "metadata": { "type": "string", "pattern": "^sheets/[A-Za-z][A-Za-z0-9_-]{0,63}\\.meta\\.json$" }
        },
        "additionalProperties": true
      }
    },
    "namedRanges": {
      "type": "array",
      "description": "Workbook-scoped names — spec/02-workbook.md (Named ranges).",
      "items": {
        "type": "object",
        "required": ["name", "refersTo"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$",
            "maxLength": 255,
            "description": "Must also not look like a cell reference, be TRUE or FALSE, or be a Core function name, and must be unique ignoring case (spec/02-workbook.md)."
          },
          "refersTo": {
            "type": "string",
            "pattern": "^=",
            "description": "A formula expression with sheet-qualified references (spec/02-workbook.md)."
          }
        },
        "additionalProperties": true
      }
    },
    "source": {
      "type": "object",
      "description": "Provenance of an imported workbook (spec/14-xlsx-interoperability.md, 14.1); also written to source/source.json.",
      "required": ["format", "filename", "sha256", "importedAt", "importer", "authority"],
      "properties": {
        "format": { "enum": ["xlsx", "xlsm"] },
        "filename": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "importedAt": { "type": "string" },
        "importer": { "type": "string" },
        "authority": { "enum": ["original", "csvx"] },
        "features": { "type": "object" },
        "mappings": {},
        "warnings": { "type": "array" }
      },
      "additionalProperties": true
    },
    "calculation": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["automatic", "manual", "on-load"] },
        "iteration": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" }
  }
}
